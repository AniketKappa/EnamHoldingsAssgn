# Copy to .env.local for local runs. Never commit real values.
# Postgres (Supabase): use the Transaction pooler URI (port 6543) everywhere.
DATABASE_URL=
# Google AI Studio key (free tier). Without it the app runs, but extraction and summaries stay pending.
GEMINI_API_KEY=
# Optional fallbacks
GROQ_API_KEY=
TAVILY_API_KEY=
# Optional overrides (comma-separated fallback chains)
MODEL_T1=gemini-3.5-flash-lite,gemini-3.1-flash-lite
MODEL_T2=gemini-3.6-flash,gemini-3.8-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
MODEL_T3=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
MODEL_GROUNDED=gemini-3.6-flash,gemini-3.8-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
# Optional: protects /api/cron/tick if you use an HTTP clock instead of GitHub Actions
CRON_SECRET=
